# ====================================================================
# MAJ REALTY · variables de entorno (copiar a .env.local; NUNCA subir secretos al repositorio)
# Las variables NEXT_PUBLIC_* son visibles en el navegador: no poner secretos en ellas.
# ====================================================================

# URL pública canónica (una sola versión del dominio, con https). Propuesta, pendiente de registro:
#   https://majrealty.com.do   (alternativas: https://majrealty.do, https://majrealtysrl.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Usar la llave publicable/anon, nunca la service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Logo oficial: copiar el archivo a public/brand/ y poner la ruta. Vacío = espacio "LOGO PENDIENTE".
NEXT_PUBLIC_LOGO_SRC=

# Indexación en buscadores: dejar en false hasta el lanzamiento (sin datos de demostración y con dominio definitivo).
NEXT_PUBLIC_ALLOW_INDEXING=false

# Inglés: estructura preparada; activar cuando las traducciones estén revisadas.
NEXT_PUBLIC_ENABLE_EN=false

# ---------------- Solo servidor (secretos) ----------------
# Tareas programadas (/api/cron): secreto largo aleatorio. Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Llave service_role: SOLO para /api/cron (vencimiento de licencias). Nunca en el navegador ni en NEXT_PUBLIC_*.
# Alternativa sin esta llave: programar run_scheduled_jobs() con pg_cron dentro de Supabase (ver docs/DESPLIEGUE.md).
SUPABASE_SERVICE_ROLE_KEY=
# Sal para el hash de IP usado en límites de envío
IP_HASH_SALT=

# Protección anti-bots opcional (Cloudflare Turnstile). Sin estas llaves se usa campo trampa + tiempo mínimo + límites.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Solo para scripts locales (backup, verificación de lanzamiento). No se usa en la aplicación.
SUPABASE_DB_URL=
